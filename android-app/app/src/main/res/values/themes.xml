<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme: the app is light-only, matching the web palette. -->
    <style name="Theme.MindCircle" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Splash screen shown before Compose takes over. -->
    <style name="Theme.MindCircle.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cream</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.MindCircle</item>
    </style>
</resources>
